<div id={@id} class="flex flex-col gap-6">
  {!-- Header --}
  <div class="flex flex-wrap items-center justify-between gap-3">
    {#if @show_header}
      <div>
        <h2 class="type-title">
          {#if @title}
            {@title}{#if @entity_name}
              — {@entity_name}{/if}
          {#elseif @mode == :settings}
            {l("Rules Template")}{#if @entity_name}
              — {@entity_name}{/if}
          {#else}
            {l("Community Rules")}{#if @entity_name}
              — {@entity_name}{/if}
          {/if}
        </h2>
        <p class="text-sm text-muted mt-0.5">
          {#if @description}
            {@description}
          {#elseif @mode == :settings}
            {l("Manage the template rules that communities can choose from.")}
          {#else}
            {l("Select which rules apply and how each one is enforced.")}
          {/if}
        </p>
      </div>
    {/if}
    {!-- Summary panel (entity mode only) --}
    {#if @mode == :entity}
      {#case Bonfire.CommunityRules.Web.RulesBuilderLive.selected_summary(
          @checked,
          @qualifiers,
          @custom_rules,
          @ordered_template
        )}
        {#match []}
          <div class="alert alert-info text-sm">{l("No rules selected yet.")}</div>
        {#match summary}
          <div class="card border border-base-200 bg-base-100">
            <div class="card-body p-4 gap-3">
              <h3 class="card-title text-base">{l("Selected rules")}</h3>
              {#for {group_name, rules} <- summary}
                <div>
                  <div class="text-xs font-medium text-muted uppercase tracking-wide mb-1">{group_name}</div>
                  <ul class="flex flex-col gap-0.5">
                    {#for rule <- rules}
                      <li class="text-sm flex items-center gap-2">
                        <span class="text-primary">•</span>
                        <span>{rule.name}</span>
                        {#if rule.qualifier}
                          <span class="text-primary/70 text-xs">→ {Bonfire.CommunityRules.Qualifier.label(rule.qualifier)}</span>
                        {/if}
                      </li>
                    {/for}
                  </ul>
                </div>
              {/for}
            </div>
          </div>
      {/case}
    {/if}
  </div>

  {!-- Categories, then their sections. An instance or group orders them by drag (desktop) or with the up/down buttons --}
  {#case @mode == :entity and !@read_only}
    {#match reorderable?}
      <div
        id={"#{@id}-categories"}
        phx-hook={if reorderable?, do: "Draggable"}
        data-event="reorder_categories"
        phx-target={@myself}
        class="flex flex-col gap-6"
      >
        {#for {{top_key, top_val}, category_index} <- Enum.with_index(@ordered_template)}
          <div id={"#{@id}-category-#{top_key}"} data-sortable-item data-item={top_key}>
            <div class="flex items-center gap-2 mb-3">
              <span
                :if={reorderable?}
                data-sortable-handler
                aria-hidden="true"
                class="cursor-grab text-subtle hover:text-muted"
              ><#Icon iconify="ph:dots-six-vertical" class="size-4" /></span>
              <div class="flex-1 text-xs font-bold uppercase tracking-widest text-subtle">
                {Keyword.get(top_val, :name, to_string(top_key))}
              </div>
              <div :if={reorderable?} class="join shrink-0">
                <Bonfire.UI.Common.MoveButtonsLive
                  id={Bonfire.CommunityRules.Web.RulesBuilderLive.move_id(@id, "category", nil, top_key)}
                  values={%{kind: "category", item: top_key}}
                  label={Keyword.get(top_val, :name, to_string(top_key))}
                  first={category_index == 0}
                  last={category_index == length(@ordered_template) - 1}
                  target={@myself}
                  class="btn btn-ghost btn-xs btn-square join-item"
                />
              </div>
            </div>
            <div
              id={"#{@id}-sections-#{top_key}"}
              phx-hook={if reorderable?, do: "Draggable"}
              data-event="reorder_sections"
              data-parent={top_key}
              phx-target={@myself}
              class="flex flex-col gap-2"
            >
              {#for {{section_id, section_data}, section_index} <-
                  Enum.with_index(Keyword.get(top_val, :sections, []))}
                <StatelessComponent
                  module={maybe_component(Bonfire.CommunityRules.Web.RulesSectionLive, @__context__)}
                  parent_id={@id}
                  category_id={to_string(top_key)}
                  section_id={to_string(section_id)}
                  section_data={section_data}
                  mode={@mode}
                  checked={@checked}
                  qualifiers={@qualifiers}
                  inherited={@inherited}
                  custom_rules={@custom_rules}
                  open_sections={@open_sections}
                  add_custom_mode={@add_custom_mode}
                  read_only={@read_only}
                  reorderable={reorderable?}
                  first={section_index == 0}
                  last={section_index == length(Keyword.get(top_val, :sections, [])) - 1}
                  target={@myself}
                />
              {/for}
            </div>
          </div>
        {/for}
      </div>
  {/case}

  {#if !@read_only}
    <div class="flex gap-2">
      <button
        id={"#{@id}-export-json-btn"}
        phx-click="show_export"
        phx-value-format="json"
        phx-target={@myself}
        class="btn btn-sm gap-1"
      >
        <#Icon iconify="ph:export" class="size-4" />{l("Export JSON")}
      </button>
      <button
        id={"#{@id}-export-elixir-btn"}
        phx-click="show_export"
        phx-value-format="elixir"
        phx-target={@myself}
        class="btn btn-sm gap-1"
      >
        <#Icon iconify="ph:code" class="size-4" />{l("Export config")}
      </button>
    </div>
  {/if}

  {!-- Save button (settings mode only — entity mode auto-saves) --}
  {#if !@read_only && @mode == :settings}
    <div>
      <button
        id={"#{@id}-save-rules-btn"}
        phx-click="save"
        phx-target={@myself}
        class="btn btn-primary"
      >
        {l("Save template")}
      </button>
    </div>
  {/if}

  {!-- Export modal --}
  {#if @export_format}
    <div
      id={"#{@id}-export-modal"}
      class="modal modal-open"
      role="dialog"
      aria-modal="true"
      aria-labelledby={"#{@id}-export-modal-title"}
      tabindex="-1"
      phx-click-away="close_export"
      phx-window-keydown="close_export"
      phx-key="Escape"
      phx-target={@myself}
      phx-mounted={JS.focus(to: "##{@id}-close-export-btn")}
    >
      <div class="modal-box w-full max-w-2xl" phx-click="">
        <h3 id={"#{@id}-export-modal-title"} class="type-heading mb-3">
          {#if @export_format == "json"}{l("Export as JSON")}{#else}{l("Export as Elixir config")}{/if}
        </h3>
        <textarea
          id={"#{@id}-export-output"}
          class="textarea textarea-bordered w-full font-mono text-xs"
          rows="16"
          readonly
        >{@export_output}</textarea>
        <div class="modal-action">
          <button
            id={"#{@id}-copy-export-btn"}
            phx-hook="CopyToClipboard"
            data-target={"#{@id}-export-output"}
            class="btn btn-sm btn-ghost"
          >{l("Copy")}</button>
          <button
            id={"#{@id}-close-export-btn"}
            phx-click="close_export"
            phx-target={@myself}
            class="btn btn-sm"
          >{l("Close")}</button>
        </div>
      </div>
    </div>
  {/if}
</div>
