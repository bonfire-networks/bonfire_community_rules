<div
  id={"#{@parent_id}-tmpl-rule-#{@section_id}-#{@rule_id}"}
  class="flex items-center gap-2 px-2 py-1.5 rounded-lg group hover:bg-base-200"
>
  {!-- View mode --}
  <div
    id={"#{@parent_id}-tmpl-rule-view-#{@section_id}-#{@rule_id}"}
    class="flex items-center gap-2 flex-1 min-w-0"
  >
    <span class="text-sm flex-1 truncate" title={@rule_meta[:name] || @rule_id}>{@rule_meta[:name] || @rule_id}</span>
    {#if @rule_meta[:has_qualifier]}
      <span class="badge badge-ghost badge-xs shrink-0">{l("qualifier")}</span>
    {/if}
    {#if !@read_only}
      <button
        type="button"
        id={"#{@parent_id}-tmpl-rule-edit-btn-#{@section_id}-#{@rule_id}"}
        class="btn btn-sm btn-ghost btn-square shrink-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 [@media(hover:none)]:opacity-100"
        aria-label={l("Edit rule")}
        phx-click={JS.hide(to: "##{@parent_id}-tmpl-rule-view-#{@section_id}-#{@rule_id}")
        |> JS.show(to: "##{@parent_id}-tmpl-rule-edit-#{@section_id}-#{@rule_id}", display: "flex")
        |> JS.focus(to: "##{@parent_id}-tmpl-rule-input-#{@section_id}-#{@rule_id}")}
      >
        <#Icon iconify="ph:pencil-simple" class="w-4 h-4" />
      </button>
      <button
        phx-click="delete_template_rule"
        phx-value-section={@section_id}
        phx-value-rule={@rule_id}
        phx-target={@target}
        class="btn btn-sm btn-ghost btn-square text-error shrink-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 [@media(hover:none)]:opacity-100"
        aria-label={l("Delete rule")}
      >
        <#Icon iconify="ph:trash" class="w-4 h-4" />
      </button>
    {/if}
  </div>

  {!-- Edit mode (hidden by default) --}
  {#if !@read_only}
    <form
      id={"#{@parent_id}-tmpl-rule-edit-#{@section_id}-#{@rule_id}"}
      phx-submit="update_template_rule"
      phx-target={@target}
      class="hidden items-center gap-2 flex-1 min-w-0"
    >
      <input type="hidden" name="section_id" value={@section_id}>
      <input type="hidden" name="rule_id" value={@rule_id}>
      <input
        type="text"
        name="name"
        id={"#{@parent_id}-tmpl-rule-input-#{@section_id}-#{@rule_id}"}
        value={@rule_meta[:name] || @rule_id}
        class="input input-xs input-bordered flex-1 min-w-0"
        placeholder={l("Rule name...")}
      />
      <button type="submit" class="btn btn-sm btn-primary shrink-0">{l("Save")}</button>
      <button
        type="button"
        class="btn btn-sm btn-ghost shrink-0"
        phx-click={JS.show(to: "##{@parent_id}-tmpl-rule-view-#{@section_id}-#{@rule_id}")
        |> JS.hide(to: "##{@parent_id}-tmpl-rule-edit-#{@section_id}-#{@rule_id}")
        |> JS.focus(to: "##{@parent_id}-tmpl-rule-edit-btn-#{@section_id}-#{@rule_id}")}
      >{l("Cancel")}</button>
    </form>
  {/if}
</div>
