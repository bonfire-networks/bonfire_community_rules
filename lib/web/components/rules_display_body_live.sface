{!-- when collapsible, rules past `show_first` carry `data-extra` and stay hidden until the "Show all" checkbox is ticked (`[data-show-first]` in app.css): no JS, so it works on static guest pages, and the list isn't split so the numbering stays continuous --}
<div data-show-first={@collapsible}>
  <input
    :if={@collapsible and length(all_rules(@sections)) > @show_first}
    type="checkbox"
    id={"#{@id}-all"}
    class="sr-only"
  />
  <ol class={class_for(@classes, :list)}>
    {#for {rule, idx} <- Enum.with_index(all_rules(@sections), 1)}
      <li class={class_for(@classes, :item)} data-extra={@collapsible and idx > @show_first}>
        <span class={class_for(@classes, :index)}>
          {idx}
        </span>
        <div class="flex-1 flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class={class_for(@classes, :name)}>{e(rule, :name, nil)}</span>
          {#case e(rule, :qualifier, nil)}
            {#match nil}
            {#match q}
              <span
                data-role="rule-qualifier"
                class={
                  "inline-flex items-center px-1.5 py-px rounded-md text-xs font-medium",
                  "bg-error/10 text-error": q == "no",
                  "bg-success/10 text-success": q == "yes",
                  "bg-warning/15 text-warning": q in ["with_label", "with_approval"]
                }
              >{Bonfire.CommunityRules.Qualifier.label(q)}</span>
          {/case}
        </div>
      </li>
    {/for}
  </ol>
  <div
    :if={(@collapsible and length(all_rules(@sections)) > @show_first) or slot_assigned?(:footer)}
    class={class_for(@classes, :footer)}
  >
    <label
      :if={@collapsible and length(all_rules(@sections)) > @show_first}
      for={"#{@id}-all"}
      data-role="show-all"
      class={class_for(@classes, :show_all)}
    >
      <span data-when="closed">{l("Show all %{count} rules", count: length(all_rules(@sections)))}</span>
      <span data-when="open">{l("Show fewer")}</span>
    </label>
    <#slot {@footer} />
  </div>
</div>
