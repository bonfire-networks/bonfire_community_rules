<div data-rules-collapsible={@collapsible}>
  <ol class={class_for(@classes, :list)}>
    {#for {rule, idx} <- Enum.with_index(all_rules(@sections), 1)}
      <li class={class_for(@classes, :item)}>
        <span class={class_for(@classes, :index)}>
          {idx}
        </span>
        <div class="flex-1 flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class={class_for(@classes, :name)}>{e(rule, :name, nil)}</span>
          {#case e(rule, :qualifier, nil)}
            {#match nil}
            {#match q}
              <span
                data-role="rule-qualifier"
                class={
                  "inline-flex items-center px-1.5 py-px rounded-md text-xs font-medium",
                  "bg-error/10 text-error": q == "no",
                  "bg-success/10 text-success": q == "yes",
                  "bg-warning/15 text-warning": q in ["with_label", "with_approval"]
                }
              >{Bonfire.CommunityRules.Qualifier.label(q)}</span>
          {/case}
        </div>
      </li>
    {/for}
  </ol>
  {!-- rules past the 10th are hidden by CSS in app.css until this sets `data-expanded` on the wrapper --}
  <div :if={@collapsible and length(all_rules(@sections)) > 10} class="flex justify-center mt-3">
    <button
      type="button"
      data-role="rules_expand"
      aria-expanded="false"
      phx-click={JS.toggle_attribute({"data-expanded", ""}, to: {:closest, "[data-rules-collapsible]"})
      |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
      class="group inline-flex expand-pill"
    >
      <span class="group-aria-expanded:hidden">{l("Show more")}</span>
      <span class="hidden group-aria-expanded:inline">{l("Show less")}</span>
      <#Icon iconify="ph:caret-down-bold" class="w-3 h-3 transition-transform group-aria-expanded:rotate-180" />
    </button>
  </div>
</div>
