<div id={@id}>
  {#if is_list(@sections) and @sections != []}
    {#if @show_header}
      {!-- <details> gives native disclosure: aria-expanded, keyboard support,
           and open/close state without JS. The chevron rotates via group-open. --}
      <details
        open
        class="group rounded-box border border-base-content/15 bg-base-100 [&_summary::-webkit-details-marker]:hidden pb-4"
      >
        <summary class="list-none cursor-pointer flex items-center justify-between gap-3 px-5 py-4 select-none rounded-t-box hover:bg-base-200/50 transition-colors">
          <div class="flex items-center gap-2.5 text-base font-medium text-base-content">
            <#Icon
              iconify="ph:scales-duotone"
              class="w-[18px] h-[18px] text-base-content"
              aria-hidden="true"
            />
            <span>{@title || l("Rules")}</span>
          </div>
          <#Icon
            iconify="ph:caret-down-bold"
            class="w-3.5 h-3.5 text-muted transition-transform duration-200 group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <div class="px-5 pb-5 pt-1">
          <Bonfire.CommunityRules.Web.RulesDisplayBodyLive sections={@sections} />
        </div>
      </details>
    {#else}
      <Bonfire.CommunityRules.Web.RulesDisplayBodyLive sections={@sections} />
    {/if}
  {/if}
</div>
