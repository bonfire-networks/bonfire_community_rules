{!-- Unnamed sections (e.g. the always-present custom bucket) are always open with no collapsible header --}
<div class={if Keyword.get(@section_data, :name),
  do: "border border-secondary rounded-xl bg-base-100 overflow-hidden",
  else: ""}>
  {#if Keyword.get(@section_data, :name)}
    <button
      id={"#{@parent_id}-section-header-#{@section_id}"}
      phx-click="toggle_section"
      phx-value-id={@section_id}
      phx-target={@target}
      aria-expanded={if Map.get(@open_sections, @section_id, false), do: "true", else: "false"}
      aria-controls={"#{@parent_id}-section-body-#{@section_id}"}
      class="w-full flex items-center justify-between p-3 text-left hover:bg-base-200 focus-visible:bg-base-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 transition-colors"
    >
      <span class="font-medium">{Keyword.get(@section_data, :name)}</span>
      <div class="flex items-center gap-2">
        {#if @mode == :entity}
          {#case Bonfire.CommunityRules.Web.RulesBuilderLive.count_selected(@checked, @section_id)}
            {#match 0}
              <span class="badge badge-ghost badge-sm">{l("none selected")}</span>
            {#match n}
              <span class="badge badge-primary badge-sm">{n} {l("selected")}</span>
          {/case}
        {#else}
          <span class="badge badge-ghost badge-sm">{lp("%{count} rule", "%{count} rules", length(Keyword.get(@section_data, :rules, [])),
              count: length(Keyword.get(@section_data, :rules, []))
            )}</span>
        {/if}
        <Iconify.iconify
          icon={if Map.get(@open_sections, @section_id, false), do: "ph:caret-up-bold", else: "ph:caret-down-bold"}
          class="w-4 h-4 text-base-content/40"
        />
      </div>
    </button>
  {/if}

  {#if !Keyword.get(@section_data, :name) || Map.get(@open_sections, @section_id, false)}
    <div
      id={"#{@parent_id}-section-body-#{@section_id}"}
      role="region"
      aria-labelledby={"#{@parent_id}-section-header-#{@section_id}"}
      class={if Keyword.get(@section_data, :name),
        do: "px-3 pb-3 flex flex-col gap-1 border-t border-secondary pt-2",
        else: "flex flex-col gap-1"}
    >
      {#for {rule_id, rule_meta} <- Keyword.get(@section_data, :rules, [])}
        {#if @mode == :entity}
          <StatelessComponent
            module={maybe_component(Bonfire.CommunityRules.Web.RulesEntityRuleLive, @__context__)}
            parent_id={@parent_id}
            section_id={@section_id}
            rule_id={to_string(rule_id)}
            rule_meta={rule_meta}
            checked={@checked}
            qualifiers={@qualifiers}
            read_only={@read_only}
            target={@target}
          />
        {#else}
          <StatelessComponent
            module={maybe_component(Bonfire.CommunityRules.Web.RulesTemplateRuleLive, @__context__)}
            parent_id={@parent_id}
            section_id={@section_id}
            rule_id={to_string(rule_id)}
            rule_meta={rule_meta}
            read_only={@read_only}
            target={@target}
          />
        {/if}
      {/for}

      {#if Map.get(@custom_rules, @section_id, []) != []}
        <div
          id={"#{@parent_id}-custom-rules-list-#{@section_id}"}
          phx-hook="Draggable"
          data-event="reorder_custom_rules"
          data-parent={@section_id}
          class="flex flex-col gap-0.5 mt-1"
        >
          {#for custom <- Map.get(@custom_rules, @section_id, [])}
            <StatelessComponent
              module={maybe_component(Bonfire.CommunityRules.Web.RulesCustomRuleLive, @__context__)}
              parent_id={@parent_id}
              section_id={@section_id}
              rule={custom}
              mode={@mode}
              read_only={@read_only}
              target={@target}
            />
          {/for}
        </div>
      {/if}

      {#if !@read_only}
        {#if Map.get(@add_custom_mode, @section_id)}
          <form
            id={"#{@parent_id}-add-custom-form-#{@section_id}"}
            phx-submit={if @mode == :entity, do: "add_custom_rule", else: "add_template_custom_rule"}
            phx-target={@target}
            class="flex gap-2 mt-2"
          >
            <input
              type="hidden"
              name={if @mode == :entity, do: "group_id", else: "section_id"}
              value={@section_id}
            />
            <label for={"#{@parent_id}-custom-rule-input-#{@section_id}"} class="sr-only">{l("Rule name...")}</label>
            <input
              type="text"
              name="name"
              id={"#{@parent_id}-custom-rule-input-#{@section_id}"}
              class="input input-sm input-bordered flex-1"
              placeholder={l("Rule name...")}
              autofocus
            />
            {#if @mode == :settings}
              <label class="flex items-center gap-1 text-sm cursor-pointer">
                <input type="checkbox" name="has_qualifier" value="true" class="checkbox checkbox-xs">
                {l("qualifier")}
              </label>
            {/if}
            <button type="submit" class="btn btn-sm btn-primary">{l("Add")}</button>
            <button
              type="button"
              phx-click="toggle_add_custom"
              phx-value-id={@section_id}
              phx-target={@target}
              class="btn btn-sm btn-ghost"
            >{l("Cancel")}</button>
          </form>
        {#else}
          <button
            id={"#{@parent_id}-add-custom-btn-#{@section_id}"}
            phx-click="toggle_add_custom"
            phx-value-id={@section_id}
            phx-target={@target}
            class="btn btn-sm btn-ghost self-start mt-1 text-muted hover:text-base-content"
          >
            + {if @mode == :entity, do: l("Add custom rule"), else: l("Add rule")}
          </button>
        {/if}
      {/if}
    </div>
  {/if}
</div>
